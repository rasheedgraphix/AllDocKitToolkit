{
  "name": "alldockit",
  "private": true,
  "version": "1.0.2",
  "description": "AllDocKit - Professional Offline Document Image and PDF Studio by Rasheed Graphix",
  "author": "Hafiz Nouman Rasheed <rasheedgraphix@gmail.com>",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "electron:start": "node scripts/prepare_appx_assets.js && vite build && npx electron .",
    "electron:dev": "node scripts/prepare_appx_assets.js && npx concurrently \"tsx server.ts\" \"npx wait-on http://localhost:3000 && npx electron .\"",
    "electron:build": "node scripts/prepare_appx_assets.js && vite build && npx electron-builder --win",
    "electron:store": "node scripts/prepare_appx_assets.js && vite build && npx electron-builder --win appx",
    "tauri": "tauri",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.rasheedgraphix.alldockit",
    "productName": "AllDocKit Toolkit",
    "copyright": "Copyright 2026 Rasheed Graphix (Hafiz Nouman Rasheed)",
    "directories": {
      "output": "dist-appx",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "public/**/*",
      "build/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "appx",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "appx": {
      "applicationId": "AllDocKitToolkit",
      "identityName": "RasheedGraphix.AllDocKitToolkit",
      "publisherDisplayName": "RasheedGraphix",
      "publisher": "CN=3A9DCC04-8828-4172-8554-421A85179DB3",
      "backgroundColor": "#090D16"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AllDocKit"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.7.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "gh-pages": "^6.3.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
